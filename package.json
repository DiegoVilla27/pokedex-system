{
  "name": "@pokedex/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "npx nx run-many -t dev",
    "build": "npx nx run-many -t build",
    "test": "npx nx run-many -t test",
    "graph": "npx nx graph",
    "docker": "docker compose up build -d",
    "clean:backoffice": "rm -rf apps/pokedex-backoffice/node_modules apps/pokedex-backoffice/.angular",
    "clean:ionic": "rm -rf apps/pokedex-ionic/node_modules apps/pokedex-ionic/.angular",
    "clean": "rm -rf node_modules .nx pnpm-lock.yaml && pnpm clean:backoffice && pnpm clean:ionic && pnpm i"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "rxjs": "~7.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "nx": "23.1.2",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.4"
  }
}