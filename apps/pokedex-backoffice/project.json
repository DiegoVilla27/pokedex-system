{
  "name": "pokedex-backoffice",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm dev",
        "cwd": "apps/pokedex-backoffice"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm build",
        "cwd": "apps/pokedex-backoffice"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm test",
        "cwd": "apps/pokedex-backoffice"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build",
        "build"
      ],
      "options": {
        "command": "docker build -t pokedex-backoffice:latest -f apps/pokedex-backoffice/Dockerfile .",
        "cwd": "."
      }
    }
  }
}